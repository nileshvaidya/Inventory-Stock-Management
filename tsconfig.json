{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src/**/*.js", "scripts/**/*.js", "scripts/**/*.mjs", "vite.config.js", "tailwind.config.js"],
  "exclude": ["node_modules", "dist", "design-reference"]
}
