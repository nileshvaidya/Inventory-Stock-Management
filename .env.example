# Copy to .env and fill in values from your Supabase project
# (Project Settings -> API). Vite only exposes VITE_-prefixed vars to the
# client bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by scripts/seed.js and future RLS integration test scripts
# (trusted local/CI scripts) — never exposed to the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
